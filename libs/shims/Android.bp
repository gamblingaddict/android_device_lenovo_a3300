cc_library_shared {
    name: "libshim_cutils",
    srcs: ["libshim_atomic.cpp"],
    shared_libs: ["libcutils",],
    proprietary: true,
}

cc_library_shared {
    name: "libshim_utils",
    srcs: ["libshim_utils.cpp"],
    shared_libs: ["libutils", "liblog"],
    proprietary: true,
}

cc_library_shared {
    name: "libshim_log",
    srcs: ["xlog.c"],
    shared_libs: ["liblog"],
    proprietary: true,
}

cc_library_shared {
    name: "libbluetoothdrv",
    srcs: ["audio.cpp"],
    shared_libs: ["libshim_log", "libshim_cutils", "libshim_utils", "libbt-vendor"],
    proprietary: true,
}
